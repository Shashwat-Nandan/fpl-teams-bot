{
  "name": "fpl-manager-crawler",
  "version": "1.0.0",
  "description": "Crawls the FPL Overall league to build a searchable manager directory (player_name, team_name, team_id).",
  "main": "src/index.js",
  "bin": {
    "fpl-crawler": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test-run": "node src/index.js --max-pages 3",
    "backfill": "node src/backfill.js",
    "backfill-test": "node src/backfill.js --max-ids 5",
    "export": "node src/export.js",
    "export-full": "node src/export.js --full",
    "export-status": "node src/export.js --status",
    "export-dry-run": "node src/export.js --dry-run",
    "stats": "node src/stats.js",
    "export-csv": "node src/export.js --format csv",
    "ship": "bin/ship-exports.sh",
    "test": "node test-smoke.js && node test-export.js && node test-season.js && node test-throughput.js && node test-handoff.js"
  },
  "dependencies": {
    "@dsnp/parquetjs": "^1.8.8",
    "better-sqlite3": "^11.3.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
